# --- Sanity (create a free project at https://www.sanity.io/manage) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Mailing-list signups → Sanity `subscriber` docs (server-only; Editor token) ---
# sanity.io/manage → project → API → Tokens → Add API token (Editor)
SANITY_API_WRITE_TOKEN=your_sanity_write_token

# --- Optional: also forward signups to Buttondown (server-only) ---
# https://buttondown.email/settings/api
BUTTONDOWN_API_KEY=
